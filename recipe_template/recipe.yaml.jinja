# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json
context:
  oot_name: {{ oot_name }}
  name: gnuradio-{{ oot_name }}
  # update script relies on `git_url` and `git_branch` and can replace:
  #   `git_rev`, `base_version`, `date_str`, `build`
  git_url: {{ git_url }}
  git_branch: {{ git_branch }}
  git_rev:
  base_version:
  date_str:
  version: {% raw %}${{ base_version }}.post${{ date_str }}+g${{ git_rev[:7] }}{% endraw %}
  build: "0"

package:
  name: {% raw %}${{ name|lower }}{% endraw %}
  version: {% raw %}${{ version }}{% endraw %}

source:
  git: {% raw %}${{ git_url }}{% endraw %}
  rev: {% raw %}${{ git_rev }}{% endraw %}

build:
  number: {% raw %}${{ build }}{% endraw %}
{%- if python_only %}
  string: {% raw %}${{ "win" if win else "unix" }}_py_${{ build }}{% endraw %}
  noarch: python
{%- endif %}
  files:
    exclude:
      - "**/gdk-pixbuf*"
      - "**/*.pyc"

requirements:
  build:
    - if: build_platform != target_platform
      then:
        - python
        - {% raw %}cross-python_${{ target_platform }}{% endraw %}
        - numpy
        - pybind11
    - {% raw %}${{ compiler("c") }}{% endraw %}
    - {% raw %}${{ stdlib("c") }}{% endraw %}
    - {% raw %}${{ compiler("cxx") }}{% endraw %}
    - cmake
    - git
    - ninja
    - pkg-config
  host:
    - gnuradio-core
    - libboost-devel
    - numpy
    - if: win
      then: pip
    - pybind11
    {%- if python_only %}
    - {% raw %}python ${{ python_min }}.*{% endraw %}
    {%- else %}
    - python
    {%- endif %}
  run:
    {%- if python_only %}
    - if: unix
      then: __unix
    - if: win
      then: __win
    # Need gnuradio as a run dep because noarch doesn't do run_exports.
    # This pin can be more relaxed than the gnuradio run_exports because the
    # API is stable at the 'x.x' level and we don't need to worry about ABI.
    - {% raw %}${{ pin_compatible('gnuradio-core', lower_bound='x.x', upper_bound='x.x') }}{% endraw %}
    {%- endif %}
    - numpy
    {%- if python_only %}
    - {% raw %}python >=${{ python_min }}{% endraw %}
    {%- else %}
    - python
    {%- endif %}
  ignore_run_exports:
    from_package:
      {%- if python_only %}
      - {% raw %}${{ compiler("c")|split|first }}{% endraw %}
      - {% raw %}${{ stdlib("c")|split|first }}{% endraw %}
      - {% raw %}${{ compiler("cxx")|split|first }}{% endraw %}
      {%- endif %}
      # this only builds against the headers
      - libboost-devel

tests:
  - python:
      imports:
        - gnuradio.{{ oot_name }}
      pip_check: false
  - package_contents:
      {%- if not python_only %}
      include:
        - gnuradio/{{ oot_name }}/api.h
      lib:
        - gnuradio-{{ oot_name }}
      {%- endif %}
      files:
        {%- if installs_examples %}
        # Example flowgraphs
        {%- for eg in example_flowgraphs_list %}
        - {% raw %}${{ "Library/" if win }}{% endraw %}share/gnuradio/examples/{{ oot_name }}/{{ eg.removesuffix(".grc") }}.grc
        {%- endfor %}
        {%- endif %}

        {%- if installs_grc_blocks %}
        # GRC blocks
        {%- for blk in grc_blocks_list %}
        - {% raw %}${{ "Library/" if win }}{% endraw %}share/gnuradio/grc/blocks/{{ oot_name }}_{{ blk.removeprefix("{{ oot_name }}_").removesuffix(".block.yml") }}.block.yml
        {%- endfor %}
        {%- endif %}
  - script:
      - if: unix
        then: |
          # Put commands that test the package on Linux or macOS below

          {%- if installs_examples %}
          # Verify that example flowgraphs can be generated
          {%- for eg in example_flowgraphs_list %}
          grcc $PREFIX/share/gnuradio/examples/{{ oot_name }}/{{ eg.removesuffix(".grc") }}.grc
          {%- endfor %}
          {%- endif %}
      - if: win
        then: |
          :: Put commands that test the package on Windows below

          {%- if installs_examples %}
          :: Verify that example flowgraphs can be generated
          {%- for eg in example_flowgraphs_list %}
          grcc %PREFIX%\\Library\\share\\gnuradio\\examples\\{{ oot_name }}\\{{ eg.removesuffix(".grc") }}.grc
          {%- endfor %}
          {%- endif %}
    requirements:
      run:
        {%- if installs_examples %}
        - gnuradio-grc
        {%- if python_only %}
        - {% raw %}python ${{ python_min }}.*{% endraw %}
        {%- endif %}
        {%- endif %}

about:
  homepage: {{ homepage }}
  license: {{ license }}
  license_file: {{ license_file }}
  summary: {{ summary }}
  description: >
    {{ description.strip() | indent(4) }}

    {%- if installs_examples %}

    Example gnuradio-companion flowgraphs are installed with the package and
    can be found in:
        - (Linux/macOS) `$CONDA_PREFIX/share/gnuradio/examples/{{ oot_name }}`
        - (Windows) `%CONDA_PREFIX%\share\gnuradio\examples\{{ oot_name }}`
    {%- endif %}
{% if maintainer_username %}
extra:
  recipe-maintainers:
    - {{ maintainer_username }}
{% endif -%}
